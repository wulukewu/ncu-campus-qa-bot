# =============================================================================
# RAG Server Environment Variables
# =============================================================================
# Get your Gemini API key from: https://aistudio.google.com/app/apikey

# Gemini API Key (REQUIRED)
GEMINI_API_KEY=(your api key)

# Server Mode (rag or llm)
MODE=rag

# Optional: Uncomment to change default model
# GEMINI_FLASH_MODEL=gemini-1.5-flash-latest
# GEMINI_EMBED_MODEL=models/text-embedding-004

# =============================================================================
# LINE Bot Environment Variables
# =============================================================================
# Get your LINE credentials from: https://developers.line.biz/console/

# LINE Channel Access Token (REQUIRED)
# Found in: LINE Developers Console > Your Channel > Messaging API > Channel access token
LINE_CHANNEL_ACCESS_TOKEN=(your token)

# LINE Channel Secret (REQUIRED)
# Found in: LINE Developers Console > Your Channel > Basic settings > Channel secret
LINE_CHANNEL_SECRET=(your secret)


# RAG Server URL (REQUIRED)
# For Docker: use 'rag-server' as hostname
# For local: use 'localhost' or '127.0.0.1'
RAG_SERVER_URL=http://127.0.0.1:8000/v1/chat/completions
# Flask Environment (development/production)
FLASK_ENV=development

# Flask debug mode (0 or 1)
FLASK_DEBUG=1


LINE_PUSH_ENABLED="1"

